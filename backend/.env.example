# Defaults preserve the current local Mosquitto + FastAPI setup.
SKYGUARD_MQTT_HOST=127.0.0.1
SKYGUARD_MQTT_PORT=1883
SKYGUARD_MQTT_TOPIC=skyguard/aws/+/telemetry
# HiveMQ Cloud example: set host, port=8883, username/password, and TLS=true.
SKYGUARD_MQTT_USERNAME=
SKYGUARD_MQTT_PASSWORD=
SKYGUARD_MQTT_TLS=false

# Comma-separated; add the LAN frontend origin here when needed.
SKYGUARD_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional absolute path. Defaults to backend/skyguard.db.
# SKYGUARD_DATABASE_PATH=C:\path\to\skyguard.db

# Hybrid Random Forest v6. Defaults are already correct when the model stays in app/models/.
SKYGUARD_ML_ENABLED=true
# SKYGUARD_ML_MODEL_PATH=C:\path\to\backend\app\models\skyguard_final_hybrid_rf_v6.joblib
SKYGUARD_ML_CONFIDENCE_THRESHOLD=0.70
SKYGUARD_ML_MIN_SAMPLES=4

# Adaptive packet timing. These are safety floors/multipliers; each station
# learns its own robust expected interval from recent successful arrivals.
SKYGUARD_EXPECTED_SAMPLE_INTERVAL_SECONDS=3
SKYGUARD_COMMUNICATION_INTERVAL_WINDOW_SAMPLES=20
SKYGUARD_COMMUNICATION_EXPECTED_MIN_SECONDS=1
SKYGUARD_COMMUNICATION_EXPECTED_MAX_SECONDS=8
SKYGUARD_COMMUNICATION_WARNING_MIN_SECONDS=6
SKYGUARD_COMMUNICATION_FAILURE_MIN_SECONDS=10
SKYGUARD_COMMUNICATION_WARNING_MULTIPLIER=2.5
SKYGUARD_COMMUNICATION_FAILURE_MULTIPLIER=4
SKYGUARD_PEER_FRESHNESS_MIN_SECONDS=10
SKYGUARD_PEER_FRESHNESS_MULTIPLIER=3

# Live freeze debounce. Simulation retains deterministic sample-based timing.
SKYGUARD_FREEZE_MIN_DURATION_SECONDS=20
SKYGUARD_FREEZE_CONFIRMATION_EVALUATIONS=2
SKYGUARD_FREEZE_ML_STRONG_CONFIDENCE=0.85
